{
  "name": "aop",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Organization Protocol and Organization Kernel",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome lint apps packages vitest.config.ts",
    "format": "biome format --write apps packages vitest.config.ts",
    "format:check": "biome format apps packages vitest.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
