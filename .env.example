# PostgreSQL
POSTGRES_DB=aop
POSTGRES_USER=aop
POSTGRES_PASSWORD=aop-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aop:aop-local-password@localhost:5432/aop

# S3-compatible local object store (Versity Gateway)
S3_ENDPOINT=http://localhost:7070
S3_REGION=us-east-1
S3_ACCESS_KEY=aop-local
S3_SECRET_KEY=aop-local-secret-change-me
S3_BUCKET=aop-artifacts
S3_FORCE_PATH_STYLE=true
S3_PORT=7070
S3_WEB_PORT=8080
